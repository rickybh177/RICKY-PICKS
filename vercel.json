{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:ruta((?!api/).*)",
      "has": [{ "type": "host", "value": "rickypicks.com.mx" }],
      "destination": "https://dattip.com/:ruta",
      "permanent": true
    }
  ]
}
