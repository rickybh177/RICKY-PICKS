{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    },
    "api/ig-daily.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/ig-daily",
      "schedule": "0 15 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:ruta((?!api/).*)",
      "has": [{ "type": "host", "value": "rickypicks.com.mx" }],
      "destination": "https://dattip.com/:ruta",
      "permanent": true
    }
  ]
}
